{
  "seed": 42,
  "cross_validation": {
    "n_folds": 10
  },
  "training": {
    "max_epochs": 2000,
    "steps_per_epoch": 10,
    "record_every_epochs": 100,
    "early_stopping_start_epoch": 1000,
    "early_stopping_patience_epochs": 300
  },
  "objective": {
    "max_canonical_dimensions": 16,
    "tpe_canonical_dimensions": 3,
    "grid_canonical_dimensions": 3,
    "early_stopping_canonical_dimensions": 3
  },
  "tpe": {
    "n_trials": 400,
    "hidden_dim": [128, 256, 512],
    "latent_dim": [16, 32, 64],
    "learning_rate": {"low": 1e-6, "high": 1e-3, "log": true},
    "alpha": {"low": 1.0, "high": 100.0, "log": true},
    "gamma": {"low": 0.1, "high": 50.0, "log": true}
  },
  "grid": {
    "hidden_dim": [128, 256],
    "latent_dim": [16, 32],
    "learning_rate": [1e-6, 5e-6, 1e-5],
    "alpha": [15.0, 16.0, 17.0, 18.0, 19.0, 20.0],
    "gamma": [3.0, 4.0, 5.0, 6.0, 7.0, 8.0]
  }
}
